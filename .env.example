# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
LOG_LEVEL=INFO

# 数据库配置
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=shopkeeper_kb

# 本地目录配置
DOC_DIR=/home/roott/work/doc
DOWNLOAD_DIR=/home/roott/work/download
OUTPUT_DOC_DIR=/home/roott/work/output_doc

# MinerU 配置
MINERU_TOKEN=
MINERU_BASE_URL=https://mineru.net
# 单次解析最大页数限制（MinerU 当前为 200；若未来更换 API，可调大或设为 0 表示不限制）
MINERU_PAGE_LIMIT=200
# 分卷切分页数（实际切分页数 = min(MINERU_SPLIT_PAGES, MINERU_PAGE_LIMIT)；若 MINERU_PAGE_LIMIT=0 则使用 MINERU_SPLIT_PAGES）
MINERU_SPLIT_PAGES=200
# 分卷并发数（分卷级别并行上传/轮询/下载/解压；1 表示串行）
MINERU_CONCURRENCY=1

# Markdown 图片上下文抽取配置（字符数）
MD_IMG_CONTEXT_CHARS=300
