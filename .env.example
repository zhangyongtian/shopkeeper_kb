# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
LOG_LEVEL=INFO

# 数据库配置
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=shopkeeper_kb

# Redis（用于图片描述缓存）
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL_S=2592000

# MinIO（用于图片与图片元数据存储）
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shopkeeper-kb
MINIO_SECURE=false
# 用于写回 Markdown 的公开可访问地址（按你的实际局域网 IP 修改）
MINIO_PUBLIC_BASE_URL=http://192.168.25.133:9002

# 本地目录配置
DOC_DIR=/home/roott/work/doc
DOWNLOAD_DIR=/home/roott/work/download
OUTPUT_DOC_DIR=/home/roott/work/output_doc

# MinerU 配置
MINERU_TOKEN=
MINERU_BASE_URL=https://mineru.net
# 单次解析最大页数限制（MinerU 当前为 200；若未来更换 API，可调大或设为 0 表示不限制）
MINERU_PAGE_LIMIT=200
# 分卷切分页数（实际切分页数 = min(MINERU_SPLIT_PAGES, MINERU_PAGE_LIMIT)；若 MINERU_PAGE_LIMIT=0 则使用 MINERU_SPLIT_PAGES）
MINERU_SPLIT_PAGES=200
# 分卷并发数（分卷级别并行上传/轮询/下载/解压；1 表示串行）
MINERU_CONCURRENCY=1

# Markdown 图片上下文抽取配置（字符数）
MD_IMG_CONTEXT_CHARS=300

# 是否将处理后的 md_content 覆盖写回 md_path 对应文件（默认 false）
MD_WRITEBACK=false
# 覆盖写回时是否生成一次性 .bak 备份（若已存在同名 .bak 则不再生成）
MD_WRITEBACK_BACKUP=true

# 千问多模态（OpenAI Compatible）配置
QWEN_API_KEY=
# 例如：https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
QWEN_VL_MODEL=qwen3-vl-flash
QWEN_TIMEOUT_S=60
QWEN_MAX_RETRY=6
# 并发与节流（2000 张图片建议从 2 并发、1 RPS 起步）
QWEN_CONCURRENCY=2
QWEN_RPS=1
